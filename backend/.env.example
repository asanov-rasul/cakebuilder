PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/cakebuilder
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,https://cakebuilder-beige.vercel.app

# Number of reverse proxies in front of the API (Render, Railway, Heroku,
# Nginx...). Needed so rate limits see the real client IP. 0 = none.
TRUST_PROXY=1
